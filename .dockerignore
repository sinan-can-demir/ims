.env
*.pyc
__pycache__
redis-data

# Dev-only — never needed in the image, and .venv/.git alone are ~1GB of
# pure waste in every build (COPY . . was copying them wholesale before
# this was added).
.venv/
.git/
.pytest_cache/
.ruff_cache/

# Local pipeline/ML artifacts — regenerated by make train/export/warehouse,
# not needed at runtime. Left out of the build context before, they'd get
# baked into the image by COPY . . (bloat, and risk of shipping trained
# models / business data into a registry unintentionally).
mlflow.db
mlflow.db-*
mlruns/
models/*.pkl
data_lake/
feature_store/
warehouse/*.duckdb

# Terraform, not part of the runtime — untracked by git (see .gitignore)
# but still present in the local build context after `terraform init`, so
# COPY . . was baking downloaded provider binaries (with their own CVEs)
# into the app image.
infra/.terraform/
infra/terraform.tfvars

# The Tauri desktop app (#174) is a separate app — none of its source is
# ever needed by these Python images. Whole directory, not just
# src-tauri/target/ and node_modules/: those change on every single Rust
# compile / npm install, which was invalidating COPY . .'s cache on every
# `docker compose up --build` regardless of whether app/ itself changed —
# real, measured slowdown discovered while testing #192.
desktop/
