# Copy this to terraform.tfvars (gitignored — never commit real values)
# and fill in. Or set as environment variables, e.g. TF_VAR_jwt_secret=...

# Generate with: openssl rand -hex 32
jwt_secret = "REPLACE_ME"

# Uncomment to override defaults:
# aws_region   = "us-east-1"
# project_name = "ims"
# environment  = "prod"

# RDS hardened-by-default settings (see infra/rds.tf and infra/README.md's
# "Notes / known limitations" section) — override for a cheaper/looser
# dev-test deployment:
# db_multi_az                = false  # single-AZ, ~half the RDS cost
# db_backup_retention_period = 7      # days; 0 disables automated backups
# db_deletion_protection     = true   # must be false before `terraform destroy`
