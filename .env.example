# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------
# Local dev default — change for staging/prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ims

# Postgres URL for integration tests. When set, tests run against real Postgres.
# When unset, tests use SQLite in-memory (postgres-marked tests are skipped).
TEST_DATABASE_URL=

# -------------------------------------------------------------------
# SQLAlchemy connection pool
# Pool size: number of persistent connections kept open
# Max overflow: extra connections allowed above pool_size under load
# -------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -------------------------------------------------------------------
# API
# -------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# In production set this to your frontend domain, e.g.:
#   CORS_ORIGINS=https://dashboard.yourdomain.com
CORS_ORIGINS=http://localhost:8501

# Webhook signature verification (POST /api/webhooks/{organization_id}/ingest)
# is a per-organization secret stored in organizations.webhook_secret, not
# an env var — see SECURITY.md. A NULL webhook_secret disables signature
# verification for that org only (local dev only).

# Secret key used to sign/verify JWTs issued by POST /api/auth/login and
# checked by every /api route (HS256, 12-hour expiry, no refresh tokens).
# Unlike the old API_KEY, this can't be "disabled" by leaving it unset —
# if unset, the app falls back to a fixed, publicly-known dev secret
# (logged loudly at startup) so login still works locally, but anyone can
# forge a valid-looking token. Always set this in any real deployment:
#   openssl rand -hex 32
JWT_SECRET=

# Default rate limit applied to /api routes (slowapi syntax, e.g. "100/minute").
# Keyed by client IP. /health, /metrics, and the signature-verified webhook
# endpoint are exempt. NOTE: storage is per-worker-process, not shared across
# Gunicorn workers in prod — effective limit there is ~WEB_CONCURRENCY x this
# value. See SECURITY.md.
RATE_LIMIT=100/minute

# Every deployment always has organization_id on every row — this only
# gates UI/CLI *visibility* of org concepts (org-selection UI,
# scripts/create_organization.py's beyond-the-bootstrap-org prompts), not
# the schema. Leave false for a normal single-tenant self-hosted install.
ALLOW_MULTIPLE_ORGS=false

# -------------------------------------------------------------------
# Data pipeline paths (override if running outside the project root)
# Each of these 4 can also be an s3:// URI instead of a local path — see
# the S3 / object storage section below. Read directly by the app
# (app/config.py) and by dbt (warehouse/ims_warehouse/profiles.yml,
# models/sources.yml — via the same env var names).
# -------------------------------------------------------------------
DATA_LAKE_ROOT=./data_lake
WAREHOUSE_ROOT=./warehouse
FEATURE_STORE_PATH=./feature_store
MODELS_DIR=./models

# The DuckDB catalog file (warehouse/ims.duckdb) — deliberately separate
# from WAREHOUSE_ROOT above and always local, even when WAREHOUSE_ROOT is
# an s3:// URI. There's no supported way to run a writable DuckDB database
# directly on S3; the catalog is rebuilt from S3-hosted source parquet on
# each `dbt run` instead of living on S3 itself. Not an s3:// URI, ever.
WAREHOUSE_DB_PATH=./warehouse/ims.duckdb

# -------------------------------------------------------------------
# S3 / object storage (optional — only used if one of the 4 paths above
# is set to an s3:// URI; local paths ignore all of this entirely).
# Leave S3_ENDPOINT_URL unset for real AWS S3. Set it for MinIO or any
# other S3-compatible self-hosted endpoint, e.g.:
#   S3_ENDPOINT_URL=http://minio:9000
# S3_URL_STYLE=path is required for MinIO and most self-hosted S3-compatible
# servers (bucket in the URL path); leave unset for real AWS S3 (bucket in
# the hostname, the default "vhost" style).
# -------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_ENDPOINT_URL=
S3_URL_STYLE=

# -------------------------------------------------------------------
# MinIO (docker-compose.minio.yml / docker-compose.prod.yml only).
# Not read directly by the app — these are MinIO's own root credentials.
# docker-compose.prod.yml wires them into AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY/S3_ENDPOINT_URL above automatically; only needed
# here to set MinIO's own admin login.
# -------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -------------------------------------------------------------------
# Warehouse date range
# -------------------------------------------------------------------
WAREHOUSE_START_DATE=2020-01-01
WAREHOUSE_END_DATE=2030-12-31

# -------------------------------------------------------------------
# docker-compose.prod.yml / docker-compose.caddy.yml only
# (self-hosted deployment — see docs/deployment/self-hosted.md).
# Not read directly by the app; used for compose-level variable
# substitution to build DATABASE_URL and avoid the dev default password.
# -------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ims

# Domain pointed at your server, for automatic HTTPS via Caddy.
# Leave unset if you're not using docker-compose.caddy.yml.
DOMAIN=

# Basic-auth credentials protecting the Streamlit dashboard at
# https://<DOMAIN>:8501 (docker-compose.caddy.yml only — the dashboard has
# no auth of its own; without this overlay it isn't reachable at all).
# Generate the hash with the command below — note the `sed` at the end:
# bcrypt hashes contain literal `$` characters, and Compose's .env-file
# interpolation treats unescaped `$word` as a variable reference, silently
# truncating the hash. The `sed` doubles each `$` (`$$`) so Compose passes
# the hash through unmangled.
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>' | sed 's/\$/$$/g'
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_HASH=

# Number of Gunicorn worker processes serving the API (production only —
# the base docker-compose.yml dev command ignores this and always runs a
# single Uvicorn process). Rule of thumb: 2x vCPU cores + 1.
WEB_CONCURRENCY=4

# -------------------------------------------------------------------
# Observability
# -------------------------------------------------------------------
# Directory prometheus_client uses to merge /metrics data across Gunicorn's
# worker processes. Already set in docker-compose.prod.yml — only needed
# here if running Gunicorn with WEB_CONCURRENCY > 1 outside Compose.
# See docs/observability.md.
PROMETHEUS_MULTIPROC_DIR=
