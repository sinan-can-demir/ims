{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IMS Desktop",
  "version": "0.1.0",
  "identifier": "com.ims.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IMS Desktop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../app": "repo/app",
      "../../dashboard": "repo/dashboard",
      "../../docker": "repo/docker",
      "../../deploy": "repo/deploy",
      "../../config": "repo/config",
      "../../migrations": "repo/migrations",
      "../../scripts": "repo/scripts",
      "../../requirements.txt": "repo/requirements.txt",
      "../../requirements-train.txt": "repo/requirements-train.txt",
      "../../pyproject.toml": "repo/pyproject.toml",
      "../../.dockerignore": "repo/.dockerignore"
    }
  }
}
