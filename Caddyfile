{$DOMAIN} {
	reverse_proxy api:8000
}

# The dashboard has its own per-user sign-in now (dashboard/auth.py,
# authenticate_user() called in-process — no HTTP call, no bearer token),
# but basic_auth here still stands: it's a network-perimeter control
# (keeps random internet traffic off the dashboard's port entirely),
# different job from per-user attribution inside the app. Neither
# replaces the other. Generate the password hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
{$DOMAIN}:8501 {
	basic_auth {
		{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_HASH}
	}
	reverse_proxy dashboard:8501
}
